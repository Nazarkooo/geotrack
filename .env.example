# Copy to .env (or run `make env`, which fills the secrets with random values).

# --- secrets ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password
# At least 32 characters; signs the API access tokens.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# At least 16 characters; devices send it as the X-Ingest-Key header.
INGEST_API_KEY=change-me-ingest-key
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# --- topology --------------------------------------------------------------
POSTGRES_USER=geotrack
POSTGRES_DB=geotrack
# Published port of the reverse proxy (UI, REST and websockets).
HTTP_PORT=8080
# Grafana, published on the loopback interface only.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
PROMETHEUS_RETENTION=6h

# --- tuning ----------------------------------------------------------------
# Ingest streams; must be identical for the API and the processor.
INGEST_SHARDS=8
INGEST_MAX_BATCH=1000
# Backpressure watermarks, counted in unprocessed stream entries.
INGEST_BACKLOG_HIGH=200000
INGEST_BACKLOG_LOW=100000
INGEST_MAX_FUTURE_SKEW_S=300
HISTORY_RETENTION_DAYS=7

DB_POOL_SIZE=10
DB_POOL_TIMEOUT_S=5
DB_STATEMENT_TIMEOUT_MS=5000

PROCESSOR_BATCH_SIZE=1000
PROCESSOR_BLOCK_MS=1000
PROCESSOR_LEASE_TTL_MS=15000
# Internal port for the processor's /metrics and health endpoints.
PROCESSOR_HTTP_PORT=9100

# Position broadcast tick; lower means fresher markers and more frames.
WS_TICK_MS=250
WS_CONTROL_QUEUE_MAX=1000
WS_SEND_TIMEOUT_S=10
WS_DEVICE_STALE_S=300
WS_GRID_CELL_DEG=0.05
WS_MAX_SESSIONS_PER_USER=20

GEOZONE_QUOTA_PER_USER=500

LOG_LEVEL=INFO
LOG_FORMAT=json

# --- load generator (profile `loadtest`) -----------------------------------
# Runs inside the compose network so it is not limited by the host's ephemeral
# ports or by Docker Desktop's port forwarding.
GENERATOR_BASE_URL=http://nginx:8080
GENERATOR_DEVICES=10000
GENERATOR_INTERVAL_S=5
GENERATOR_BATCH_SIZE=250
GENERATOR_CONCURRENCY=32
# 0 runs until the container is stopped.
GENERATOR_DURATION_S=0
